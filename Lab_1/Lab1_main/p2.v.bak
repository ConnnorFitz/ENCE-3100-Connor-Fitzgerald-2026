module lab01p2 (
    input  [9:0] SW,
    output [9:0] LEDR
);
    wire  s = SW[8];
    wire [7:0] x = SW[7:0];
    wire   y = SW[9];

    assign LEDR[0] = (~s & x[0]) | (s & y);
    assign LEDR[1] = (~s & x[1]) | (s & y);
    assign LEDR[2] = (~s & x[2]) | (s & y);
    assign LEDR[3] = (~s & x[3]) | (s & y);
    assign LEDR[4] = (~s & x[4]) | (s & y);
    assign LEDR[5] = (~s & x[5]) | (s & y);
    assign LEDR[6] = (~s & x[6]) | (s & y);
    assign LEDR[7] = (~s & x[7]) | (s & y);

endmodule